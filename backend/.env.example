# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty to use local SQLite (fine for dev).
# In production (Render), set this to your Neon connection string:
# postgres://user:password@host/dbname
DATABASE_URL=

TIME_ZONE=Asia/Dubai

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Object storage (Supabase/S3) — set USE_S3=True in production.
# Do NOT rely on Render's local disk for media files, it is ephemeral.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
